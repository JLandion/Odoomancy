<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_global_importer_form" model="ir.ui.view">
        <field name="name">odoomancy.global.importer.form</field>
        <field name="model">odoomancy.global.importer</field>
        <field name="arch" type="xml">
            <form string="D&amp;D Data Importer">
                <group>
                    <group>
                        <field name="importer_model" readonly="is_running"/>
                        <field name="import_mode" widget="radio" readonly="is_running"/>
                    </group>
                    <group>
                        <field name="progress"
                               widget="progressbar"
                               options="{'current_value': 'progress', 'max_value': '100'}"
                               readonly="1"/>
                        <field name="progress_label" readonly="1"/>
                        <field name="is_running" invisible="1"/>
                    </group>
                </group>

                <div class="row mt-3 g-2">
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Classes</div>
                            <div class="fs-4 fw-bold"><field name="count_classes" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Class Levels</div>
                            <div class="fs-4 fw-bold"><field name="count_class_level" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Spells</div>
                            <div class="fs-4 fw-bold"><field name="count_spells" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Monsters</div>
                            <div class="fs-4 fw-bold"><field name="count_monsters" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Equipment</div>
                            <div class="fs-4 fw-bold"><field name="count_equipments" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Skills</div>
                            <div class="fs-4 fw-bold"><field name="count_skills" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Ability Scores</div>
                            <div class="fs-4 fw-bold"><field name="count_ability_scores" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Proficiencies</div>
                            <div class="fs-4 fw-bold"><field name="count_proficience" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center p-2">
                            <div class="text-muted small">Features</div>
                            <div class="fs-4 fw-bold"><field name="count_features" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                </div>

                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="is_running"/>
                    <button name="action_stop"
                            type="object"
                            string="Stop"
                            class="btn-danger"
                            invisible="not is_running"/>
                    <button string="Close"
                            invisible="is_running"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_global_importer" model="ir.actions.act_window">
        <field name="name">D&amp;D Data Import</field>
        <field name="res_model">odoomancy.global.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_odoomancy_data_import"
        name="Data Import"
        parent="odoomancy.menu_odoomancy_root"
        action="action_global_importer"
        sequence="90"
    />

</odoo>
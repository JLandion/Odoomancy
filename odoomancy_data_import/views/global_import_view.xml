<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_global_importer_form" model="ir.ui.view">
        <field name="name">odoomancy.global.importer.form</field>
        <field name="model">odoomancy.global.importer</field>
        <field name="arch" type="xml">
            <form string="D&amp;D Data Importer">
                <group>
                    <group>
                        <field name="importer_model" readonly="is_running"/>
                        <field name="import_mode" widget="radio" readonly="is_running"/>
                    </group>
                    <group>
                        <field name="progress"
                               widget="progressbar"
                               options="{'current_value': 'progress', 'max_value': '100'}"
                               readonly="1"/>
                        <field name="progress_label" readonly="1"/>
                        <field name="is_running" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="is_running"/>
                    <button name="action_stop"
                            type="object"
                            string="Stop"
                            class="btn-danger"
                            invisible="not is_running"/>
                    <button string="Close"
                            invisible="is_running"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_global_importer" model="ir.actions.act_window">
        <field name="name">D&amp;D Data Import</field>
        <field name="res_model">odoomancy.global.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_odoomancy_data_import"
        name="Data Import"
        parent="odoomancy.menu_odoomancy_root"
        action="action_global_importer"
        sequence="90"
    />

</odoo>
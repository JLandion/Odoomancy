<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_equipment_importer_form" model="ir.ui.view">
        <field name="name">odoomancy.equipment.importer.form</field>
        <field name="model">odoomancy.equipment.importer</field>
        <field name="arch" type="xml">
            <form string="Import Equipment">
                <group>
                    <field name="import_mode"/>
                </group>

                <group string="Results">
                    <field name="created_count" readonly="1"/>
                    <field name="updated_count" readonly="1"/>
                    <field name="error_count" readonly="1"/>
                </group>

                <footer>
                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_importer" model="ir.actions.act_window">
        <field name="name">Import Equipment</field>
        <field name="res_model">odoomancy.equipment.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_equipment_importer"
        name="Import Equipment"
        parent="menu_odoomancy_data_import_root"
        action="action_equipment_importer"
        sequence="20"
    />

</odoo>
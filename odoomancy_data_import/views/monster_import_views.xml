<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_monster_importer_form" model="ir.ui.view">
        <field name="name">odoomancy.monster.importer.form</field>
        <field name="model">odoomancy.monster.importer</field>
        <field name="arch" type="xml">
            <form string="Import Monsters">
                <group>
                    <group>
                        <field name="import_mode" widget="radio"
                               readonly="is_running"/>
                    </group>
                    <group>
                        <field name="progress" widget="progressbar"
                               options="{'current_value': 'progress', 'max_value': '100'}"
                               readonly="1"/>
                        <field name="progress_label" readonly="1"/>
                        <field name="is_running" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="is_running"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_monster_importer" model="ir.actions.act_window">
        <field name="name">Import Monsters</field>
        <field name="res_model">odoomancy.monster.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_odoomancy_data_import_root"
        name="Data Import"
        parent="odoomancy.menu_odoomancy_root"
        sequence="90"
    />

    <menuitem
        id="menu_monster_importer"
        name="Import Monsters"
        parent="menu_odoomancy_data_import_root"
        action="action_monster_importer"
        sequence="10"
    />

</odoo>
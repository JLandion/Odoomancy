<odoo>

    <record id="action_odoomancy_monster" model="ir.actions.act_window">
        <field name="name">Monster</field>
        <field name="res_model">odoomancy.monster</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_odoomancy_monster_list" model="ir.ui.view">
        <field name="name">odoomancy.monster.list</field>
        <field name="model">odoomancy.monster</field>
        <field name="arch" type="xml">
            <list string="Monsters">
                <field name="name"/>
                <field name="challenge_rating"/>
                <field name="hit_points"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_monster_form" model="ir.ui.view">
        <field name="name">odoomancy.monster.form</field>
        <field name="model">odoomancy.monster</field>
        <field name="arch" type="xml">
            <form string="Monster">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="challenge_rating"/>
                        </group>
                        <group>
                            <field name="hit_points"/>
                            <field name="armor_class"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Spells">
                            <field name="spell_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
<odoo>

    <record id="action_odoomancy_campaign_log" model="ir.actions.act_window">
        <field name="name">Diary</field>
        <field name="res_model">odoomancy.campaign.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_odoomancy_campaign_log_list" model="ir.ui.view">
        <field name="name">odoomancy.campaign.log.list</field>
        <field name="model">odoomancy.campaign.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="author_id"/>
                <field name="entry_date"/>
                <field name="visibility"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_campaign_log_form" model="ir.ui.view">
        <field name="name">odoomancy.campaign.log.form</field>
        <field name="model">odoomancy.campaign.log</field>
        <field name="arch" type="xml">
            <form string="Diary Entry">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="campaign_id"/>
                        <field name="author_id"/>
                        <field name="entry_date"/>
                        <field name="visibility"/>
                    </group>
                    <group>
                        <field name="content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

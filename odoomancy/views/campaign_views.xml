<odoo>

    <!-- ACTION -->
    <record id="action_odoomancy_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">odoomancy.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- list VIEW -->
    <record id="view_odoomancy_campaign_list" model="ir.ui.view">
        <field name="name">odoomancy.campaign.list</field>
        <field name="model">odoomancy.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dm_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_odoomancy_campaign_form" model="ir.ui.view">
        <field name="name">odoomancy.campaign.form</field>
        <field name="model">odoomancy.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="dm_id"/>
                        <field name="player_ids" widget="many2many_tags"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>

                        <page string="Characters">
                            <field name="character_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="player_id"/>
                                    <field name="level"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Diary">
                            <field name="log_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="author_id"/>
                                    <field name="entry_date"/>
                                    <field name="visibility"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>

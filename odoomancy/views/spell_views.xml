<odoo>

    <!-- Action -->
    <record id="action_odoomancy_spell" model="ir.actions.act_window">
        <field name="name">Spells</field>
        <field name="res_model">odoomancy.spell</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_odoomancy_spell_list"/>
    </record>

    <!-- Views -->
    <record id="view_odoomancy_spell_list" model="ir.ui.view">
        <field name="name">odoomancy.spell.list</field>
        <field name="model">odoomancy.spell</field>
        <field name="arch" type="xml">
            <list string="Spells">
                <field name="name"/>
                <field name="level"/>
                <field name="casting_time"/>
                <field name="range"/>
                <field name="duration"/>
                <field name="ritual"/>
                <field name="concentration"/>
                <field name="class_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_spell_form" model="ir.ui.view">
        <field name="name">odoomancy.spell.form</field>
        <field name="model">odoomancy.spell</field>
        <field name="arch" type="xml">
            <form string="Spell">
                <sheet>
                    <group colspan="3">
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                            <field name="casting_time"/>
                            <field name="range"/>
                            <field name="duration"/>
                            <field name="ritual"/>
                            <field name="concentration"/>
                            <field name="verbal"/>
                            <field name="somatic"/>
                        </group>
                        <group>
                            <field name="material"/>
                            <field name="material_component"/>
                            <!--field name="attack_type"/-->
                            <field name="damage_type_id"/>
                            <!--field name="area_of_effect_size"/>
                            <field name="area_of_effect_type"/-->
                        </group>
                    </group>
                    <group colspan="2">
                        <field name="class_ids"/>
                    </group>
                    <group>
                        <group>
                            <field name="damage_at_slot_ids" widget="one2many_list">
                                <list editable="bottom">
                                    <field name="level"/>
                                    <field name="value" string="Damage"/>
                                </list>
                            </field>
                        </group>
                        <group>
                            <field name="heal_at_slot_ids" widget="one2many_list">
                                <list editable="bottom">
                                    <field name="level"/>
                                    <field name="value" string="Heal"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                            <field name="higher_level_description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
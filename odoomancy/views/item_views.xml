<odoo>

    <record id="action_odoomancy_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">odoomancy.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_odoomancy_item_list" model="ir.ui.view">
        <field name="name">odoomancy.item.list</field>
        <field name="model">odoomancy.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="item_type"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_item_form" model="ir.ui.view">
        <field name="name">odoomancy.item.form</field>
        <field name="model">odoomancy.item</field>
        <field name="arch" type="xml">
            <form string="Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="item_type"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

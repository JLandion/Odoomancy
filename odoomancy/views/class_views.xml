<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== ODOOMANCY CLASS ==================== -->

    <record id="view_odoomancy_class_list" model="ir.ui.view">
        <field name="name">odoomancy.class.list</field>
        <field name="model">odoomancy.class</field>
        <field name="arch" type="xml">
            <list string="Classes">
                <field name="name"/>
                <field name="type"/>
                <field name="hit_die"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_class_kanban" model="ir.ui.view">
        <field name="name">odoomancy.class.kanban</field>
        <field name="model">odoomancy.class</field>
        <field name="arch" type="xml">
            <kanban string="Classes">
                <field name="name"/>
                <field name="type"/>
                <field name="hit_die"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong class="fs-5">
                                <field name="name"/>
                            </strong>
                            <field name="type" widget="badge"/>
                        </div>
                        <div class="text-muted">
                            Hit Die: d<field name="hit_die"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_odoomancy_class_form" model="ir.ui.view">
        <field name="name">odoomancy.class.form</field>
        <field name="model">odoomancy.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Class name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Base Info">
                            <field name="type"/>
                            <field name="hit_die"/>
                            <field name="api_index"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <notebook>
                        <page string="Levels">
                            <field name="class_level_ids">
                                <list>
                                    <field name="level"/>
                                    <field name="prof_bonus"/>
                                    <field name="ability_score_bonuses"/>
                                </list>
                            </field>
                        </page>
                        <page string="Proficiencies">
                            <group>
                                <field name="proficiencie_ids" widget="many2many_tags"/>
                                <field name="proficience_choice_ids" widget="many2many_tags"/>
                                <field name="ability_scores" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Equipment">
                            <group>
                                <field name="equipment_starting" widget="many2many_tags"/>
                                <field name="equipment_options" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Spells">
                            <field name="spell_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="level"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoomancy_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">odoomancy.class</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ==================== ODOOMANCY CLASS LEVEL ==================== -->

    <record id="view_odoomancy_class_level_list" model="ir.ui.view">
        <field name="name">odoomancy.class.level.list</field>
        <field name="model">odoomancy.class.level</field>
        <field name="arch" type="xml">
            <list string="Class Levels">
                <field name="class_id"/>
                <field name="level"/>
                <field name="prof_bonus"/>
                <field name="ability_score_bonuses"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_class_level_form" model="ir.ui.view">
        <field name="name">odoomancy.class.level.form</field>
        <field name="model">odoomancy.class.level</field>
        <field name="arch" type="xml">
            <form string="Class Level">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="class_id"/> — Level <field name="level"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Stats">
                            <field name="level"/>
                            <field name="prof_bonus"/>
                            <field name="ability_score_bonuses"/>
                            <field name="api_index"/>
                        </group>
                    </group>
                    <group string="Features">
                        <field name="features" nolabel="1"/>
                    </group>
                    <group string="Class Specific">
                        <field name="class_specific" nolabel="1" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoomancy_class_level" model="ir.actions.act_window">
        <field name="name">Class Levels</field>
        <field name="res_model">odoomancy.class.level</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"group_by": ["class_id"]}</field>
    </record>

    <menuitem
        id="menu_odoomancy_class_root"
        name="Classes"
        parent="odoomancy.menu_odoomancy_root"
        sequence="10"
    />

    <menuitem
        id="menu_odoomancy_class"
        name="Classes"
        parent="menu_odoomancy_class_root"
        action="action_odoomancy_class"
        sequence="10"
    />

    <menuitem
        id="menu_odoomancy_class_level"
        name="Class Levels"
        parent="menu_odoomancy_class_root"
        action="action_odoomancy_class_level"
        sequence="20"
    />

</odoo>
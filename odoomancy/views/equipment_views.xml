<odoo>

    <record id="action_odoomancy_equipment" model="ir.actions.act_window">
        <field name="name">Equipments</field>
        <field name="res_model">odoomancy.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_odoomancy_equipment_list" model="ir.ui.view">
        <field name="name">odoomancy.equipment.list</field>
        <field name="model">odoomancy.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="equipment_type"/>
            </list>
        </field>
    </record>

    <record id="view_odoomancy_equipment_form" model="ir.ui.view">
        <field name="name">odoomancy.equipment.form</field>
        <field name="model">odoomancy.equipment</field>
        <field name="arch" type="xml">
            <form string="equipment">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="equipment_type"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
